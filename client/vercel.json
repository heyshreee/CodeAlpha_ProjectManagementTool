{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "https://<api-vercel-domain>/uploads/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://<api-vercel-domain>/socket.io/$1" },
    { "source": "/api/(.*)", "destination": "https://<api-vercel-domain>/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}