# ---------------------------------------------------------------------------
# ProjectFlow environment configuration
# Copy this file to `server/.env` and fill in real values.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Server
PORT=3000
# Allowed CORS origin (comma-separated list supported). Must match the frontend origin.
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database. SQLite for local dev:
DATABASE_URL=file:./dev.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/project_management

# Authentication secrets — REQUIRED in production. Generate long random values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookies
# COOKIE_SECURE=true      # (defaults to true in production)
# COOKIE_SAMESITE=none    # (defaults to none in production / lax in dev)

# Frontend base URL used to build password-reset links in emails.
APP_URL=http://localhost:5173

# Email (password-reset delivery). Leave SMTP_HOST empty in local dev/test to
# print emails to the server console instead. In production SMTP is required.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true        # for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ProjectFlow <no-reply@projectflow.local>

# File uploads
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=10485760   # 10 MB

# Optional object storage (S3-compatible)
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# Logging
# LOG_LEVEL=info
