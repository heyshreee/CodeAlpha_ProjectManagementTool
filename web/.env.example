# ProjectFlow landing page build-time environment variables (web/)
# Copy to `web/.env` for local overrides. All values are optional.

# Where the workspace SPA lives. Defaults to the local dev server.
# In production set this to your deployed client app URL, e.g.:
# VITE_APP_URL=https://your-app.example.com
VITE_APP_URL=http://localhost:5173

# Backend API root (schema + host + /api/v1). Leave unset in local dev to use
# the Vite dev proxy (/api -> http://localhost:3000).
# In production set this to your hosted API, e.g.:
# VITE_API_BASE=https://your-api.example.com/api/v1
# Then the backend must allow CORS from the GitHub Pages origin and the refresh
# cookie needs COOKIE_SAMESITE=none + COOKIE_SECURE=true (see server/.env.example).
VITE_API_BASE=